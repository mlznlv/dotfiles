# ~/.zprofile

# Homebrew belongs in the login shell environment. Guard both Apple Silicon and
# Intel locations so the same file is safe across macOS hosts and harmless on Linux.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi
