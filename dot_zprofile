# ~/.zprofile

ZSH_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"

case "$OSTYPE" in
  darwin*)
    PROFILE_CONFIG="$ZSH_CONFIG_HOME/platforms/macos.profile.zsh"
    ;;
  linux*)
    PROFILE_CONFIG="$ZSH_CONFIG_HOME/platforms/linux.profile.zsh"
    ;;
  *)
    PROFILE_CONFIG=""
    ;;
esac

[[ -n "$PROFILE_CONFIG" && -r "$PROFILE_CONFIG" ]] && source "$PROFILE_CONFIG"

unset PROFILE_CONFIG ZSH_CONFIG_HOME
