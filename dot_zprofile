# ~/.zprofile

# Homebrew is a macOS-only owner in this repository. Do not activate a stray
# Homebrew installation on Linux where system packages belong to apt/mise.
if [[ "$OSTYPE" == darwin* ]]; then
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi
