*dot_aws/**
*dot_kube/**
*dot_azure/**
*dot_config/*gcloud/**
*dot_config/*gh/hosts.yml
*dot_config/*containers/auth.json
*dot_docker/config.json
*dot_terraform.d/credentials.tfrc.json
*dot_config/*terraform.d/credentials.tfrc.json
*dot_gitconfig
*dot_git-credentials
*dot_netrc
*dot_npmrc
*dot_pypirc
*dot_zsh_history

