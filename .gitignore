# Machine-local overrides and generated state.
# Leading globs cover chezmoi source attributes such as private_ or encrypted_.
*dot_config/*zsh/*local.zsh
*dot_config/*mise/*conf.d/*90-machine-local.toml
*dot_config/*starship/*preset
*dot_config/*starship/*modules
mise/config.local.toml
mise/config.*.local.toml

# Identity and credential-bearing home config stays local.
*dot_ssh/**
*dot_aws/**
*dot_kube/**
*dot_azure/**
*dot_gnupg/**
*dot_config/*gcloud/**
*dot_config/*gh/**
*dot_config/*containers/**
*dot_docker/**
*dot_terraform.d/*credentials.tfrc.json
*dot_config/*terraform.d/*credentials.tfrc.json
*dot_gitconfig
*dot_git-credentials
*dot_netrc
*dot_npmrc
*dot_pypirc
*dot_zsh_history

# Common credential-bearing registry/build-tool configuration.
*dot_config/*pip/*pip.conf
*dot_pip/*pip.conf
*dot_m2/*settings.xml
*dot_gradle/*gradle.properties
*dot_cargo/*credentials.toml

# Environment/secret files in normal repos and chezmoi source-state naming.
.env
.env.*
!.env.example
.envrc
.direnv/
*dot_env
*dot_env.*
!dot_env.example
*dot_envrc

# Private material
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.ppk
*.jks
*.keystore
*.kdbx
*.agekey
*.ovpn
*.mobileconfig
*.mobileprovision

# Local/editor noise
.DS_Store
*.swp
*.swo
*~
