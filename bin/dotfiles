#!/usr/bin/env bash

set -u

# Thin executable bootstrap: resolve the physical repository, define fixed
# component paths, load the CLI facade, and retain only top-level dispatch.
DOTFILES_VERSION="0.1.0-dev"
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
PROJECT_ROOT=$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd -P)
SOURCE_DIR=${DOTFILES_SOURCE_DIR:-"${PROJECT_ROOT}"}
CHEZMOI_BIN=${DOTFILES_CHEZMOI_BIN:-chezmoi}
CATALOG_TEMPLATE="${PROJECT_ROOT}/lib/catalog-records.tmpl"
CATALOG_PROGRAM_DIRECTORY="${PROJECT_ROOT}/lib/catalog"
CATALOG_PROGRAM="${PROJECT_ROOT}/lib/catalog.awk"
PREREQUISITE_PROGRAM="${PROJECT_ROOT}/lib/prerequisite-check.sh"
RENDER_PROGRAM="${PROJECT_ROOT}/lib/render.sh"
PLAN_PROGRAM="${PROJECT_ROOT}/lib/plan.sh"
APPLY_PROGRAM="${PROJECT_ROOT}/lib/apply.sh"
CONFIG_STATE_PROGRAM="${PROJECT_ROOT}/lib/config-state.sh"
CLI_PROGRAM="${PROJECT_ROOT}/lib/cli.sh"

if [ ! -r "$CLI_PROGRAM" ]; then
    printf 'error: CLI implementation is missing\n' >&2
    if [ "${BASH_SOURCE[0]}" = "$0" ]; then
        exit 4
    fi
    return 4
fi

# shellcheck source=../lib/cli.sh
if source "$CLI_PROGRAM"; then
    :
else
    cli_load_status=$?
    if [ "${BASH_SOURCE[0]}" = "$0" ]; then
        exit "$cli_load_status"
    fi
    return "$cli_load_status"
fi

main() {
    DOTFILES_CONFIG_DIAGNOSTIC_CONTEXT=
    [ "$#" -gt 0 ] || {
        usage
        return 0
    }

    command_name=$1
    shift
    case "$command_name" in
        help|-h|--help)
            [ "$#" -eq 0 ] || usage_error "help takes no arguments"
            usage
            ;;
        version|--version)
            [ "$#" -eq 0 ] || usage_error "version takes no arguments"
            printf 'dotfiles %s\n' "$DOTFILES_VERSION"
            ;;
        catalog)
            [ "$#" -gt 0 ] || usage_error "catalog requires a subcommand"
            subcommand=$1
            shift
            case "$subcommand" in
                validate)
                    [ "$#" -eq 0 ] || usage_error "catalog validate takes no arguments"
                    run_catalog validate
                    ;;
                *)
                    usage_error "unknown catalog subcommand $subcommand"
                    ;;
            esac
            ;;
        module|profile)
            kind=$command_name
            [ "$#" -gt 0 ] || usage_error "${kind} requires a subcommand"
            subcommand=$1
            shift
            case "$subcommand" in
                list)
                    list_command "$kind" "$@"
                    ;;
                show)
                    show_command "$kind" "$@"
                    ;;
                *)
                    usage_error "unknown ${kind} subcommand $subcommand"
                    ;;
            esac
            ;;
        resolve)
            resolve_command "$@"
            ;;
        config)
            [ "$#" -gt 0 ] || usage_error "config requires a subcommand"
            subcommand=$1
            shift
            case "$subcommand" in
                set) config_set_command "$@" ;;
                interactive) config_interactive_command "$@" ;;
                inspect) config_inspect_command "$@" ;;
                doctor) config_doctor_command "$@" ;;
                *) usage_error "unknown config subcommand $subcommand" ;;
            esac
            ;;
        prerequisite)
            [ "$#" -gt 0 ] || usage_error "prerequisite requires a subcommand"
            subcommand=$1
            shift
            case "$subcommand" in
                check) prerequisite_check_command "$@" ;;
                *) usage_error "unknown prerequisite subcommand $subcommand" ;;
            esac
            ;;
        plan)
            plan_command "$@"
            ;;
        apply)
            apply_command "$@"
            ;;
        *)
            usage_error "unknown command $command_name"
            ;;
    esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
