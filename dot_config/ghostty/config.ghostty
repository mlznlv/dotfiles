# Portable visual defaults only. Shell, prompt, runtimes, and remote sessions are
# owned by Zsh/Starship/mise/tmux respectively.

theme = dark:Catppuccin Mocha,light:Catppuccin Latte

# Keep Ghostty's bundled default font family; use a slightly larger portable size.
font-size = 14.5

window-padding-x = 8
window-padding-y = 6
window-padding-balance = true

# Shell integration may switch the cursor at the prompt; this is the terminal
# default for other contexts.
cursor-style = block
cursor-style-blink = false
